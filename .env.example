# trenches-eth configuration. Copy to `.env` (gitignored) and fill in. Never commit real keys.

# --- RPC (read-only ingest) ---
# Free public endpoint verified to expose newPendingTransactions (hash-only).
ETH_RPC_URL=https://eth.drpc.org
ETH_WS_URL=wss://eth.drpc.org

# --- Live execution (leave unset for dry-run) ---
# LIVE=1                                # NEVER set until funded keys + operator sign-off
# ETH_BOT_KEY=0x...                     # funded dedicated bot hot wallet (never personal key)
# ETH_BOT_PRIVKEY=0x...                 # alias for ETH_BOT_KEY
# FLASHBOTS_RELAY_URL=https://relay.flashbots.net
# FLASHBOTS_SIGNING_KEY=0x...           # builder signing key for bundle auth

# --- Safety caps / tunables (MEV_* override the engine defaults) ---
# MEV_BUDGET_ETH=1.0                    # bankroll (exposure cap)
# MEV_MIN_P=0.1                         # model-score floor (the "no-sandwich" lever)
# MEV_MIN_COMMIT_PROFIT=10000000        # min expected profit (wei) to commit
# MEV_THETA0=0.012 / MEV_THETA_INF=0.004
# MEV_BETA=0.004 / MEV_ALPHA_SCARCE=0.5
# MEV_MAX_SLIPPAGE=0.05                 # position/pool-depth rejection
# MEV_MAX_PRIORITY_FEE=50000000000      # priority-fee rejection (wei)
# MEV_BRIBE_WEI=10000000000000000       # builder bribe per win (0.01 ETH)
# MEV_BASE_FEE_WEI=20000000000          # base fee per gas
